+def format_runtime_result(result, ai_name: str = "AI") -> str:
+    """Render a RuntimeResult for display.
+
+    Never collapses an empty/PAUSED result into a generic 'try rephrasing'
+    message ΓÇö surfaces the runtime's own specific status and guidance instead.
+    """
+    text = (getattr(result, "result_text", "") or "").strip()
+    if text:
+        return text
+    parts: list[str] = []
+    title = (getattr(result, "title", "") or "").strip()
+    if title:
+        parts.append(title)
+    for line in (getattr(result, "thought_lines", None) or [])[-2:]:
+        line = str(line).strip()
+        if line and not line.startswith("[SYSTEM]"):
+            parts.append(line)
+    for line in (getattr(result, "action_lines", None) or [])[-3:]:
+        line = str(line).strip()
+        if line:
+            parts.append(line)
+    for line in (getattr(result, "trajectory_lines", None) or [])[-2:]:
+        line = str(line).strip()
+        if line:
+            parts.append(line)
+    if parts:
+        seen: dict[str, None] = {}
+        for p in parts:
+            seen.setdefault(p)
+        return "\n".join(seen.keys())
+    status = getattr(getattr(result, "status", None), "value", "unknown")
+    return (
+        f"I wasn't able to produce output for that request (runtime status: {status}). "
+        "If this keeps happening, check the model backend in the Visibility Window (Backend settings)."
+    )
+
