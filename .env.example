# Command Nexus(TM) — Environment Variables Template
# Copy to .env and fill in with real values from the Command Nexus Secrets file.
# DO NOT commit .env to any repository.
# DO NOT include .env in PyInstaller builds.

# License key system — HMAC secret for key generation/validation
CN_SECRET_KEY=

# Coherence matrix upgrade secret
CN_UPGRADE_SECRET=

# PayPal credentials (Client Secret now stored server-side in Supabase proxy)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal proxy authentication key (sent to Supabase Edge Function)
NEXUS_API_KEY=nexus_7f3a_2026_paypal_proxy

# Supabase (termination beacon, ingestion whitelist)
CN_SUPABASE_URL=
CN_SUPABASE_API_KEY=
